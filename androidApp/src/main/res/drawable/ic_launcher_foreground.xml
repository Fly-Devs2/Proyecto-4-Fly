<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Android Adaptive Icons use a 108dp x 108dp canvas.
      Safe Zones:
      - 66dp: Safe for Circular icons.
      - 54dp: Safest for Square/Squircle icons to ensure text doesn't touch edges.

      Reducing logo to 52dp to ensure "FLY MENSAJERIA" text is never cut off
      by any mask (Square, Squircle, or Circle).
    -->
    <item
        android:drawable="@drawable/fly_logo"
        android:gravity="center"
        android:width="52dp"
        android:height="52dp" />
</layer-list>